    "The connection failed" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결하지 못했습니다"
          }
        }
      }
    },
    "The push relay answered HTTP %lld." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이가 HTTP %lld(으)로 응답했습니다."
          }
        }
      }
    },
    "The push relay could not read the test push. Update the app." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이가 테스트 푸시를 읽지 못했습니다. 앱을 업데이트하세요."
          }
        }
      }
    },
    "The push relay credential ran out. This phone attests again on the next try; send it again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이 자격 증명이 만료되었습니다. 다음 시도 때 이 휴대폰이 다시 증명하니 다시 보내세요."
          }
        }
      }
    },
    "The push relay or APNs is limiting pushes to this phone. Try again in a minute." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이나 APNs가 이 휴대폰으로 가는 푸시를 제한하고 있습니다. 1분 뒤에 다시 시도하세요."
          }
        }
      }
    },
    "The push relay or APNs is unavailable right now. Try again later." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 푸시 릴레이나 APNs를 쓸 수 없습니다. 나중에 다시 시도하세요."
          }
        }
      }
    },
    "The push relay refused this phone's handle. This phone attests again on the next try; send it again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "푸시 릴레이가 이 휴대폰의 핸들을 거부했습니다. 다음 시도 때 이 휴대폰이 다시 증명하니 다시 보내세요."
          }
        }
      }
    },
    "This change is too large to show in full. The rest is on the computer." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항이 너무 커서 모두 보여 줄 수 없습니다. 나머지는 컴퓨터에서 보세요."
          }
        }
      }
    },
    "This computer" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 컴퓨터"
          }
        }
      }
    },
    "This file's change is too large to show on a phone." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 파일의 변경 사항은 휴대폰에서 보기에 너무 큽니다."
          }
        }
      }
    },
    "This is a binary file, so there are no lines to show." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바이너리 파일이라 보여 줄 줄이 없습니다."
