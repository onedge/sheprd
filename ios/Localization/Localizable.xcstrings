    },
    "Relays" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴레이"
          }
        }
      }
    },
    "Remove a relay before adding another: %lld are kept at most." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴레이는 최대 %lld개까지 둘 수 있습니다. 하나를 뺀 뒤 추가하세요."
          }
        }
      }
    },
    "That is not a relay's address. Type one such as https://relay.example.org." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴레이 주소가 아닙니다. https://relay.example.org 같은 주소를 입력하세요."
          }
        }
      }
    },
    "That relay is already here." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 추가된 릴레이입니다."
          }
        }
      }
    },
    "Type the address of a relay a paired computer listens on, to reach that computer through it. A computer not paired yet is still paired nearby or on its network first." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어링한 컴퓨터가 연결을 받는 릴레이의 주소를 입력하면, 그 릴레이를 거쳐 컴퓨터에 연결합니다. 아직 페어링하지 않은 컴퓨터는 먼저 가까이에서 또는 같은 네트워크에서 페어링해야 합니다."
          }
        }
      }
    },
