    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sheprd finds your computers nearby over Bluetooth when you pair one, and, when you turn it on, tells them you are near so they hold alerts while you are at the desk."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheprd는 컴퓨터를 페어링할 때 Bluetooth로 가까운 컴퓨터를 찾습니다. 이 기능을 켜면 사용자가 가까이 있다고 컴퓨터에 알려, 책상에 있는 동안 알림을 보류하게 합니다."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sheprd reads the pairing QR code Sheprd shows on your computer, and takes photos you send to a chat."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheprd는 컴퓨터의 Sheprd가 보여 주는 페어링 QR 코드를 읽고, 채팅에 보낼 사진을 찍습니다."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sheprd asks for Face ID before a chat allows every tool call without asking."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheprd는 채팅이 모든 도구 호출을 묻지 않고 허용하기 전에 Face ID를 요청합니다."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sheprd talks to Sheprd on your computers over your local network."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheprd는 로컬 네트워크로 컴퓨터의 Sheprd와 통신합니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sheprd listens while you dictate a prompt or talk to it, transcribing it on your phone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheprd는 프롬프트를 받아쓰거나 말을 걸 때 듣고, 휴대폰에서 글로 옮깁니다."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sheprd transcribes your dictated prompts and spoken commands on your phone."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sheprd는 받아쓴 프롬프트와 음성 명령을 휴대폰에서 글로 옮깁니다."
          }
        }
      }
    }
  },
  "version" : "1.0"
}