# sheprd-launcher.exe는 파일 이름입니다.
error-launch-at-login-no-launcher = 로그인할 때 실행하려면 앱 옆 { $path }에 sheprd-launcher.exe가 있어야 합니다
error-launch-at-login-current-exe = 실행 중인 실행 파일을 찾지 못했습니다
# $operation의 키는 그대로 두고 각 갈래만 번역합니다.
error-launch-at-login-registry = { $operation ->
    [open] 시작 항목을 열지 못했습니다
    [read] 시작 항목을 읽지 못했습니다
    [write] 시작 항목을 쓰지 못했습니다
   *[remove] 시작 항목을 제거하지 못했습니다
}
